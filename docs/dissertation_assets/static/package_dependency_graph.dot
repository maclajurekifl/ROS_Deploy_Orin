digraph ros_workspace_packages {
  rankdir=LR;
  graph [fontname="Helvetica"];
  node [shape=box, style="rounded,filled", color="#2D3748", fillcolor="#EBF8FF", fontname="Helvetica"];
  edge [color="#4A5568"];
  "fast_lio";
  "keyframe_scan_map";
  "lidar_odometry";
  "lio_bringup";
  "livox_ros_driver2";
  "localisation_ekf";
  "ros_project_bringup";
  "fast_lio" -> "livox_ros_driver2";
  "lio_bringup" -> "fast_lio";
  "ros_project_bringup" -> "keyframe_scan_map";
  "ros_project_bringup" -> "lidar_odometry";
  "ros_project_bringup" -> "lio_bringup";
  "ros_project_bringup" -> "livox_ros_driver2";
  "ros_project_bringup" -> "localisation_ekf";
}
