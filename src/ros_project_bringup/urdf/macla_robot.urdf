<?xml version="1.0"?>
<!-- Planar mobile platform for RViz (not collision-accurate).
     Footprint: 0.70 m long (x forward) x 0.45 m wide x 0.40 m tall.
     base_link: ground center of footprint. Front axle steers (yaw); rear wheels roll (drive). -->
<robot name="macla_robot">

  <material name="body_gray">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.15 0.15 0.18 1.0"/>
  </material>
  <material name="axle_metal">
    <color rgba="0.35 0.35 0.38 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 0.45 0.40"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
  </link>

  <link name="front_axle">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.42 0.04"/>
      </geometry>
      <material name="axle_metal"/>
    </visual>
  </link>

  <joint name="front_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_axle"/>
    <origin xyz="0.28 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="0" velocity="0"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="front_axle"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0.20 0" rpy="0 0 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="front_axle"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 -0.20 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.28 0.20 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.28 -0.20 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
